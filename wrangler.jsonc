{
  "name": "sovereign-pod",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "POD_ROOT", "class_name": "PodRoot" }
